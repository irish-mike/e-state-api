{
  "info": {
    "name": "e-state API",
    "schema": "https://schema.postman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get API health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Get database health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health/db"
      }
    },
    {
      "name": "Get listing by ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/listings/{{listingId}}"
      }
    },
    {
      "name": "Create listing",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"askingPrice\": 350000,\n  \"property\": {\n    \"propertyType\": \"apartment\",\n    \"bedrooms\": 2,\n    \"bathrooms\": 1,\n    \"floorAreaSqm\": 75,\n    \"berRating\": \"b2\",\n    \"address\": {\n      \"line1\": \"Apartment 4, 12 Example Street\",\n      \"town\": \"Dublin\",\n      \"county\": \"Dublin\",\n      \"eircode\": \"D02 X285\"\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/listings"
      }
    },
    {
      "name": "Get OpenAPI document (Development only)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/openapi/v1.json"
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5165",
      "type": "string"
    },
    {
      "key": "listingId",
      "value": "40000000-0000-4000-8000-000000000001",
      "type": "string"
    }
  ]
}
